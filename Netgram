3) app.js (routing + simple notes app)

// Simple client-side router & notes demo
const root = document.getElementById('app');
const nav = document.getElementById('nav');
const menuBtn = document.getElementById('menuBtn');

menuBtn.addEventListener('click', ()=> nav.classList.toggle('hidden'));

function saveNotes(notes){
  localStorage.setItem('mp_notes', JSON.stringify(notes));
}
function loadNotes(){
  return JSON.parse(localStorage.getItem('mp_notes') || '[]');
}

function renderHome(){
  root.innerHTML = `
    <section class="card">
      <h2>Welcome</h2>
      <p class="small">This is a starter PWA website you can turn into an app. እንኳን ደህና መጡ!</p>
    </section>
    <section class="card">
      <h3>Quick Actions</h3>
      <div class="form-row" style="margin-top:8px">
        <a class="btn" href="#/notes">Open Notes</a>
        <a class="btn" href="#/about">About</a>
      </div>
    </section>
  `;
}

function renderNotes(){
  const notes = loadNotes();
  const notesHtml = notes.map((n, i)=>`
    <div class="note">
      <h3>${escapeHtml(n.title)}</h3>
      <p>${escapeHtml(n.body)}</p>
      <div class="small">Saved: ${new Date(n.created).toLocaleString()}</div>
      <div style="margin-top:8px"><button class="btn" data-del="${i}">Delete</button></div>
    </div>
  `).join('') || '<p class="small">No notes yet.</p>';

  root.innerHTML = `
    <section class="card">
      <h2>Notes</h2>
      <form id="noteForm" class="form-row">
        <input id="title" type="text" placeholder="Title" required />
        <textarea id="body" rows="4" placeholder="Write something..."></textarea>
        <button class="btn" type="submit">Save</button>
      </form>
    </section>
    <section class="card">
      <div id="notesList">${notesHtml}</div>
    </section>
  `;

  document.getElementById('noteForm').addEventListener('submit', e=>{
    e.preventDefault();
    const t = document.getElementById('title').value.trim();
    const b = document.getElementById('body').value.trim();
    if(!t) return alert('Please enter a title');
    const arr = loadNotes();
    arr.unshift({title:t, body:b, created: Date.now()});
    saveNotes(arr);
    renderNotes();
  });

  document.querySelectorAll('[data-del]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const idx = Number(btn.getAttribute('data-del'));
      const arr = loadNotes();
      arr.splice(idx,1);
      saveNotes(arr);
      renderNotes();
    });
  });
}

function renderAbout(){
  root.innerHTML = `
    <section class="card">
      <h2>About</h2>
      <p class="small">This is a Progressive Web App starter. You can add features: authentication, sync, cloud storage, etc.</p>
    </section>
  `;
}

function router(){
  const hash = location.hash.replace('#','') || '/';
  if(hash === '/' ) renderHome();
  else if(hash.startsWith('/notes')) renderNotes();
  else if(hash.startsWith('/about')) renderAbout();
  else renderHome();
}

window.addEventListener('hashchange', router);
window.addEventListener('load', router);

// small helper
function escapeHtml(str=''){
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}


